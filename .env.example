# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Local: postgresql://user:password@localhost:5432/sigma_chat
# Docker: postgresql://sigma:changeme@postgres:5432/sigma_chat
# Supabase: postgresql://user:password@db.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/sigma_chat

# Session & Security
SESSION_SECRET=change_this_to_a_long_random_secret_at_least_32_characters

# Email Service (Resend)
# Get free API key from: https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Application
APP_URL=http://localhost:3000

# File Uploads
UPLOAD_DIR=./uploads

# Optional: Docker-specific
DB_USER=sigma
DB_PASSWORD=changeme
